{
	"manifest_version": 1,
	"id": "com.github.mrtnha.yesyoukan",
	"app_min_version": "3.4.2",
	"version": "1.3.0",
	"name": "YesYouKan",
	"description": "Create and manage Kanban boards from Joplin",
	"author": "Martin Hagemeier (fork of Laurent Cozic's YesYouKan)",
	"homepage_url": "https://github.com/mrtnha/plugin-yesyoukan",
	"repository_url": "https://github.com/mrtnha/plugin-yesyoukan",
	"platforms": [
		"desktop",
		"mobile"
	],
	"keywords": [
		"kanban",
		"boards"
	],
	"categories": [
		"productivity"
	],
	"screenshots": [
		{
			"src": "doc/images/ExampleBoardAndNote.png",
			"label": "Kanban board example"
		}
	],
	"promo_tile": {
		"src": "doc/images/PromoTile.png",
		"label": "A handwritten Kanban board"
	},
	"icons": {
		"16": "doc/images/icon16.png",
		"32": "doc/images/icon32.png",
		"48": "doc/images/icon48.png",
		"128": "doc/images/icon128.png"
	}
}